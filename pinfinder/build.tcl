# Builds the pin-finder bitstream.
#   quartus_sh -t build.tcl
#
# Step 1 compiles a trivial design only to get Quartus' .pin report, which lists
# every ball of the package and what it is (user I/O, clock input, power, config).
# Step 2 takes every user I/O that is not on a header and exposes it through one
# In-System Sources and Probes instance: each ball can be read, or driven 0/1.

package require ::quartus::project
package require ::quartus::flow

set DEVICE EP4CE6F17C8
set here [file dirname [file normalize [info script]]]
cd $here

proc read_words {path} {
    set out {}
    set fh [open $path r]
    while {[gets $fh line] >= 0} {
        foreach w [regsub {#.*} $line ""] { lappend out [string toupper $w] }
    }
    close $fh
    return $out
}

proc write_file {path text} {
    set fh [open $path w]
    puts -nonewline $fh $text
    close $fh
}

proc new_project {name} {
    global DEVICE
    project_new $name -overwrite
    set_global_assignment -name FAMILY "Cyclone IV E"
    set_global_assignment -name DEVICE $DEVICE
    set_global_assignment -name TOP_LEVEL_ENTITY $name
    set_global_assignment -name VERILOG_FILE $name.v
    set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
    set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
    set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED WITH WEAK PULL-UP"
    # nCEO (F16) is unused in a single-device chain; the board routes it as I/O.
    set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
}

proc compile {name} {
    if {[catch {execute_flow -compile} err]} {
        puts stderr "Compilation of $name failed: $err"
        project_close
        exit 1
    }
    project_close
}

set header [read_words header_pins.txt]

# --- Step 1: ball inventory -------------------------------------------------
file mkdir pinscan
cd pinscan
write_file pinscan.v "module pinscan(input wire a, output wire y);\n    assign y = ~a;\nendmodule\n"
new_project pinscan
set_location_assignment PIN_[lindex $header 0] -to a
set_location_assignment PIN_[lindex $header 1] -to y
compile pinscan
cd $here

set io {}
set ci {}
set fh [open pinscan/output_files/pinscan.pin r]
while {[gets $fh line] >= 0} {
    set f [split $line :]
    if {[llength $f] < 3} continue
    set usage [string trim [lindex $f 0]]
    set loc [string trim [lindex $f 1]]
    if {![regexp {^[A-T][0-9]+$} $loc] || [lsearch -exact $header $loc] >= 0} continue
    # Unused user I/O shows as RESERVED_INPUT*/GND*, unused dedicated (input-only)
    # clock pins as GND+. Config, JTAG and power balls are skipped.
    if {[string match RESERVED_INPUT* $usage] || $usage eq "GND*"} {
        lappend io $loc
    } elseif {$usage eq "GND+"} {
        lappend ci $loc
    }
}
close $fh
set io [lsort -dictionary $io]
set ci [lsort -dictionary $ci]
set N [llength $io]
set NI [llength $ci]
puts "Candidates: $N bidirectional I/O, $NI input-only clock pins"
if {$N == 0} { puts stderr "No candidate pins found - check pinscan/output_files/pinscan.pin"; exit 1 }

set txt "# bit pin kind  (probe bit index; sources: oe = bit, value = $N + bit)\n"
set b 0
foreach p $io { append txt "$b $p io\n"; incr b }
foreach p $ci { append txt "$b $p in\n"; incr b }
write_file candidates.txt $txt

# --- Step 2: pin-finder design ----------------------------------------------
file mkdir pinfinder
cd pinfinder
if {$NI > 0} {
    set ports "    inout  wire \[[expr {$N-1}]:0\] io,\n    input  wire \[[expr {$NI-1}]:0\] ci\n"
    set probe "{ci, io}"
} else {
    set ports "    inout  wire \[[expr {$N-1}]:0\] io\n"
    set probe "io"
}
write_file pinfinder.v "// Generated by build.tcl. Every candidate ball is readable and drivable over JTAG.
module pinfinder (
$ports);
    wire \[[expr {2*$N-1}]:0\] src;  // src\[i\] = output enable, src\[$N+i\] = output value

    genvar i;
    generate
        for (i = 0; i < $N; i = i + 1) begin : drv
            assign io\[i\] = src\[i\] ? src\[$N+i\] : 1'bz;
        end
    endgenerate

    altsource_probe #(
        .sld_auto_instance_index(\"YES\"),
        .sld_instance_index(0),
        .instance_id(\"PF\"),
        .probe_width([expr {$N+$NI}]),
        .source_width([expr {2*$N}]),
        .source_initial_value(\"0\"),
        .enable_metastability(\"NO\")
    ) issp (
        .probe($probe),
        .source(src)
    );
endmodule
"
new_project pinfinder
set i 0
foreach p $io {
    set_location_assignment PIN_$p -to "io\[$i\]"
    set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to "io\[$i\]"
    # Weakest drive, so an accidental fight with another driver stays harmless.
    set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to "io\[$i\]"
    incr i
}
set i 0
foreach p $ci {
    set_location_assignment PIN_$p -to "ci\[$i\]"
    incr i
}
compile pinfinder
cd $here
puts "Done: pinfinder/output_files/pinfinder.sof"
